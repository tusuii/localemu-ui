---
interface Props {
  label: string;
  for?: string;
  description?: string;
  hint?: string;
  optional?: boolean;
  error?: string;
  class?: string;
}
const { label, for: forId, description, hint, optional = false, error, class: cls = '' } = Astro.props;
---
<div class:list={['field', cls]}>
  <label class="field-label" for={forId}>{label}{optional && <span class="opt"> - optional</span>}</label>
  {description && <p class="field-desc">{description}</p>}
  <slot />
  {hint && <p class="field-hint">{hint}</p>}
  {error && <p class="field-error">{error}</p>}
</div>
