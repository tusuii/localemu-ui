---
import type { PageLinks } from '../lib/paging';
/** `exact`: the backend knows there is another page (e.g. it returned a non-empty remainder). Token-only backends can't tell, so by default the Next link is labelled honestly. */
interface Props { links: PageLinks; count: number; noun?: string; exact?: boolean; }
const { links, count, noun = 'items', exact = false } = Astro.props;
const on = 'btn btn-normal btn-sm';
const off = 'btn btn-normal btn-sm opacity-50 pointer-events-none';
---
<nav class="flex items-center justify-between gap-3 px-4 py-2 text-sm border-t border-line" aria-label="Pagination" data-server-pager>
  <span class="text-muted">Page {links.index + 1} · {count} {noun} shown{links.next ? (exact ? ' · more available' : ' · more may be available') : ''}</span>
  <span class="flex gap-2">
    {links.first ? <a class={on} href={links.first}>First</a> : <span class={off} aria-disabled="true">First</span>}
    {links.prev ? <a class={on} href={links.prev} rel="prev">Previous</a> : <span class={off} aria-disabled="true">Previous</span>}
    {links.next ? <a class={on} href={links.next} rel="next" title={exact ? undefined : 'The server only says there may be more; the next page can turn out to be empty.'}>{exact ? 'Next' : 'Next page (may be empty)'}</a> : <span class={off} aria-disabled="true">Next</span>}
  </span>
</nav>
