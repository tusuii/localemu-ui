---
import type { PageLinks } from '../lib/paging';
interface Props { links: PageLinks; count: number; noun?: string; }
const { links, count, noun = 'items' } = Astro.props;
const on = 'btn btn-normal btn-sm';
const off = 'btn btn-normal btn-sm opacity-50 pointer-events-none';
---
<nav class="flex items-center justify-between gap-3 px-4 py-2 text-sm border-t border-border" aria-label="Pagination" data-server-pager>
  <span class="text-muted">Page {links.index + 1} · {count} {noun} shown{links.next ? ' · more available' : ''}</span>
  <span class="flex gap-2">
    {links.first ? <a class={on} href={links.first}>First</a> : <span class={off} aria-disabled="true">First</span>}
    {links.prev ? <a class={on} href={links.prev} rel="prev">Previous</a> : <span class={off} aria-disabled="true">Previous</span>}
    {links.next ? <a class={on} href={links.next} rel="next">Next</a> : <span class={off} aria-disabled="true">Next</span>}
  </span>
</nav>
