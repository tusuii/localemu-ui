---
interface Props { title: string; description?: string; badge?: string }
const { title, description, badge } = Astro.props;
---
<div class="flex flex-wrap items-start justify-between gap-4 pb-4 pt-2">
  <div class="min-w-0">
    <h1 class="text-[28px] leading-9 break-all">{title}{badge && <span class="badge badge-soft ml-3 align-middle">{badge}</span>}</h1>
    {description && <p class="text-muted mt-1 max-w-3xl">{description}</p>}
  </div>
  <div class="flex flex-wrap items-center gap-2"><slot /></div>
</div>
