---
import Icon from './Icon.astro';
import ServiceTile from './ServiceTile.astro';
import { REGIONS, regionName } from '../lib/config';
import { groupByCategory, type CatalogEntry } from '../lib/services';

interface Props { catalog: CatalogEntry[]; region: string; account: string; online: boolean; version?: string }
const { catalog, region, account, online, version } = Astro.props;
const groups = groupByCategory(catalog);
const redirect = Astro.url.pathname + Astro.url.search;
const keywords = (e: CatalogEntry) => [e.name, e.id, e.description, ...(e.keywords ?? [])].join(' ').toLowerCase();
---
<header class="sticky top-0 z-40 bg-nav text-nav-fg">
  <div class="flex h-[52px] items-center gap-1.5 px-3">
    <button type="button" class="btn btn-ghost btn-icon !text-white lg:!hidden" data-toggle-sidenav aria-label="Toggle navigation"><Icon name="menu" size={20} /></button>

    <a href="/" class="mr-2 flex items-center gap-2 !text-white hover:!no-underline" aria-label="LocalEmu Console home">
      <span class="grid h-8 w-8 place-items-center rounded-md bg-primary text-white"><Icon name="cloud" size={20} /></span>
      <span class="hidden text-[17px] font-bold leading-none sm:block">LocalEmu <span class="font-normal opacity-70">Console</span></span>
    </a>

    <div class="relative">
      <button type="button" class="flex h-9 items-center gap-1 rounded px-3 font-bold hover:bg-white/10" data-menu-toggle="menu-services" aria-haspopup="true">
        <Icon name="layout-grid" size={16} /> <span class="hidden sm:inline">Services</span> <Icon name="chevron-down" size={14} />
      </button>
      <div id="menu-services" class="menu !fixed left-2 right-2 top-[56px] !max-h-[calc(100vh-80px)] overflow-y-auto sm:!absolute sm:left-0 sm:right-auto sm:top-full sm:mt-1 sm:!w-[min(980px,94vw)]" data-services-menu>
        <div class="sticky top-0 z-10 border-b border-line bg-surface p-3">
          <input type="search" class="input" placeholder="Filter services" aria-label="Filter services" data-services-filter />
        </div>
        <div class="grid gap-x-6 p-4 sm:grid-cols-2 lg:grid-cols-3">
          {groups.map((g) => (
            <div class="mb-4 break-inside-avoid" data-svc-group>
              <h3 class="mb-1 text-[12px] uppercase tracking-wide text-muted">{g.name}</h3>
              <ul>
                {g.items.map((s) => (
                  <li data-svc-item data-kw={keywords(s)}>
                    <a href={s.link} class="flex items-center gap-2 rounded px-1.5 py-1 text-fg hover:bg-hover hover:no-underline" title={s.description}>
                      <ServiceTile icon={s.icon} category={s.category} size={22} />
                      <span class:list={[!s.hasConsole && 'text-muted']}>{s.name}</span>
                      {s.hasConsole && <span class="ml-auto h-1.5 w-1.5 rounded-full bg-success" title="Full console"></span>}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
        <div class="border-t border-line px-4 py-2 text-[13px]"><a href="/services">View all services</a><span class="ml-3 text-muted"><span class="mr-1 inline-block h-1.5 w-1.5 rounded-full bg-success align-middle"></span>has a full console</span></div>
      </div>
    </div>

    <div class="relative mx-1 hidden max-w-xl flex-1 md:block">
      <input type="search" id="global-search" class="peer h-9 w-full rounded-lg border border-white/25 bg-white/10 pl-9 pr-16 text-white placeholder:text-white/60 focus:bg-white focus:text-black focus:placeholder:text-black/50" placeholder="Search services" autocomplete="off" aria-label="Search services" data-global-search />
      <span class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-white/60 peer-focus:text-black/50"><Icon name="search" size={16} /></span>
      <span class="kbd pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 !border-white/30 !text-white/70 peer-focus:hidden">Alt+S</span>
      <div id="search-results" class="menu left-0 right-0 top-full mt-1 max-h-[60vh] overflow-y-auto" data-search-results></div>
    </div>

    <div class="ml-auto flex items-center gap-0.5">
      <span class="hidden items-center gap-1.5 px-2 text-[13px] lg:flex" data-conn data-online={online ? 'true' : 'false'} title={online ? `LocalEmu ${version ?? ''} is reachable` : 'LocalEmu is not reachable'}>
        <span class:list={['h-2 w-2 rounded-full', online ? 'bg-[#2ea597]' : 'bg-[#ff7a7a]']} data-conn-dot></span>
        <span data-conn-text>{online ? `v${version ?? ''}` : 'offline'}</span>
      </span>

      <button type="button" class="btn btn-ghost btn-icon !text-white" data-theme-toggle title="Toggle dark mode" aria-label="Toggle dark mode"><Icon name="moon" size={18} /></button>

      <div class="relative">
        <button type="button" class="flex h-9 items-center gap-1 rounded px-2.5 hover:bg-white/10" data-menu-toggle="menu-region" aria-haspopup="true">
          <Icon name="globe" size={16} /> <span class="hidden max-w-[22ch] truncate font-bold sm:inline">{regionName(region)}</span><span class="font-bold sm:hidden">{region}</span> <Icon name="chevron-down" size={14} />
        </button>
        <form id="menu-region" method="post" action="/api/context" class="menu right-0 top-full mt-1 max-h-[70vh] overflow-y-auto">
          <input type="hidden" name="redirect" value={redirect} />
          <div class="px-4 pb-1 pt-2 text-[12px] font-bold uppercase tracking-wide text-muted">Region</div>
          {REGIONS.map((r) => (
            <button type="submit" name="region" value={r.id} class="menu-item" aria-current={r.id === region ? 'true' : undefined}>
              <span class="w-4">{r.id === region && <Icon name="circle-check" size={14} class="text-link" />}</span>
              <span class:list={[r.id === region && 'font-bold']}>{r.name}</span><span class="ml-auto pl-4 text-[12px] text-muted">{r.id}</span>
            </button>
          ))}
        </form>
      </div>

      <div class="relative">
        <button type="button" class="flex h-9 items-center gap-1 rounded px-2.5 hover:bg-white/10" data-menu-toggle="menu-account" aria-haspopup="true">
          <Icon name="user" size={16} /> <span class="hidden font-mono text-[13px] sm:inline" data-account-label>{account}</span> <Icon name="chevron-down" size={14} />
        </button>
        <form id="menu-account" method="post" action="/api/context" class="menu right-0 top-full mt-1 w-[300px] p-0">
          <input type="hidden" name="redirect" value={redirect} />
          <div class="p-4">
            <div class="text-[12px] font-bold uppercase tracking-wide text-muted">Account</div>
            <div class="mt-1 font-mono text-[15px] text-fg">{account}</div>
            <p class="mt-1 text-[12px] text-muted">LocalEmu derives the account from the access key, so any 12-digit ID is a separate account.</p>
            <div class="mt-3 hidden" data-accounts-list></div>
            <label class="field-label mt-3" for="acct-input">Switch account</label>
            <div class="flex gap-2">
              <input id="acct-input" name="account" class="input font-mono" inputmode="numeric" pattern="\d{12}" maxlength="12" placeholder="123456789012" />
              <button class="btn btn-normal btn-sm" type="submit">Switch</button>
            </div>
          </div>
          <div class="menu-sep !my-0"></div>
          <a href="/settings" class="menu-item"><Icon name="settings" size={16} /> Settings</a>
        </form>
      </div>
    </div>
  </div>
</header>
