---
import Icon from './Icon.astro';
interface Props { id?: string; label?: string }
const { id = 'actions-menu', label = 'Actions' } = Astro.props;
---
<div class="relative">
  <button type="button" class="btn btn-normal" data-menu-toggle={id} aria-haspopup="true">{label} <Icon name="chevron-down" size={14} /></button>
  <div id={id} class="menu right-0 top-full mt-1"><slot /></div>
</div>
