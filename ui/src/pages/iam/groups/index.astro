---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import Icon from '../../../components/Icon.astro';
import { ListGroupsCommand, DeleteGroupCommand, CreateGroupCommand } from '@aws-sdk/client-iam';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, required, strs } from '../../../lib/action';
import { UserError, load } from '../../../lib/errors';
import { dateTime, plural } from '../../../lib/format';
import { purgeIdentity } from '../../../lib/iam';

const ctx = getCtx(Astro.cookies);
const iam = aws.iam(ctx);
const post = await handlePost(Astro, {
  create: async (f) => { const n = required(f, 'name', 'Group name'); await iam.send(new CreateGroupCommand({ GroupName: n })); return { message: `Group ${n} created.`, redirect: `/iam/groups/${encodeURIComponent(n)}` }; },
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one group.');
    for (const g of ids) { await purgeIdentity(iam, 'group', g); await iam.send(new DeleteGroupCommand({ GroupName: g })); }
    return `Deleted ${plural(ids.length, 'group')}.`;
  },
});
if (post.response) return post.response;
const res = await load(async () => {
  const out: any[] = []; let marker: string | undefined;
  do { const r = await iam.send(new ListGroupsCommand({ Marker: marker })); out.push(...(r.Groups ?? [])); marker = r.IsTruncated ? r.Marker : undefined; } while (marker);
  return out.map((g) => ({ id: g.GroupName, name: g.GroupName, path: g.Path, created: g.CreateDate, arn: g.Arn }));
});
---
<Console title="User groups" crumbs={[{ label: 'User groups' }]} error={post.error}>
  <PageHeader title="User groups" description="A group is a collection of users that share permissions." />
  <DataTable title="User groups" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Search groups" emptyTitle="No groups" emptyText="Create a group to manage permissions for many users."
    columns={[{ key: 'name', label: 'Group name', href: (r) => `/iam/groups/${encodeURIComponent(r.name)}` }, { key: 'path', label: 'Path' }, { key: 'created', label: 'Created', render: (r) => dateTime(r.created), sort: (r) => new Date(r.created ?? 0).getTime() }, { key: 'arn', label: 'ARN', mono: true }]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="Selected groups will be deleted; members are removed from them." data-confirm-title="Delete groups?" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="#create"><Icon name="plus" size={16} /> Create group</a>
    </Fragment>
  </DataTable>
  <form method="post" id="create" class="card mt-4 flex max-w-xl items-end gap-2 p-5"><input type="hidden" name="intent" value="create" />
    <div class="flex-1"><label class="field-label" for="gname">New group name</label><input id="gname" name="name" class="input" required autocomplete="off" /></div><button class="btn btn-primary" type="submit">Create group</button></form>
</Console>
