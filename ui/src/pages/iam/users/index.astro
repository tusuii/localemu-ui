---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import Icon from '../../../components/Icon.astro';
import { ListUsersCommand, DeleteUserCommand } from '@aws-sdk/client-iam';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, strs } from '../../../lib/action';
import { bulk } from '../../../lib/bulk';
import { UserError, load } from '../../../lib/errors';
import { dateTime, plural } from '../../../lib/format';
import { purgeIdentity } from '../../../lib/iam';

const ctx = getCtx(Astro.cookies);
const iam = aws.iam(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => {
    return bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'user' }, async (u) => { await purgeIdentity(iam, 'user', u); await iam.send(new DeleteUserCommand({ UserName: u })); });
  },
});
if (post.response) return post.response;
const res = await load(async () => {
  const out: any[] = []; let marker: string | undefined;
  do { const r = await iam.send(new ListUsersCommand({ Marker: marker })); out.push(...(r.Users ?? [])); marker = r.IsTruncated ? r.Marker : undefined; } while (marker);
  return out.map((u) => ({ id: u.UserName, name: u.UserName, path: u.Path, created: u.CreateDate, lastUsed: u.PasswordLastUsed, arn: u.Arn })).sort((a, b) => a.name.localeCompare(b.name));
});
---
<Console title="Users" crumbs={[{ label: 'Users' }]} error={post.error}>
  <PageHeader title="Users" description="An IAM user is an identity with long-term credentials." />
  <DataTable title="Users" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Find users by name" emptyTitle="No users" emptyText="You don't have any IAM users."
    columns={[
      { key: 'name', label: 'User name', href: (r) => `/iam/users/${encodeURIComponent(r.name)}` }, { key: 'path', label: 'Path' },
      { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => new Date(r.created ?? 0).getTime() },
      { key: 'lastUsed', label: 'Password last used', render: (r) => (r.lastUsed ? dateTime(r.lastUsed) : '-') }, { key: 'arn', label: 'ARN', mono: true },
    ]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="Selected users will be deleted along with their access keys, group memberships and attached policies." data-confirm-title="Delete users?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/iam/users/create"><Icon name="plus" size={16} /> Create user</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/iam/users/create">Create user</a>
  </DataTable>
</Console>
