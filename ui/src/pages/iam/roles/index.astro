---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import Icon from '../../../components/Icon.astro';
import { ListRolesCommand, DeleteRoleCommand } from '@aws-sdk/client-iam';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, strs } from '../../../lib/action';
import { bulk } from '../../../lib/bulk';
import { UserError, load } from '../../../lib/errors';
import { dateTime, plural } from '../../../lib/format';
import { badge } from '../../../lib/html';
import { decodeDoc, purgeIdentity } from '../../../lib/iam';

const ctx = getCtx(Astro.cookies);
const iam = aws.iam(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => {
    return bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'role' }, async (r) => { await purgeIdentity(iam, 'role', r); await iam.send(new DeleteRoleCommand({ RoleName: r })); });
  },
});
if (post.response) return post.response;
const trusted = (doc: unknown): string[] => {
  const st = (doc as any)?.Statement; const arr = Array.isArray(st) ? st : st ? [st] : [];
  return arr.flatMap((s: any) => { const p = s?.Principal; if (!p) return []; if (typeof p === 'string') return [p]; return Object.values(p).flat() as string[]; }).map((x) => String(x).replace('.amazonaws.com', ''));
};
const res = await load(async () => {
  const out: any[] = []; let marker: string | undefined;
  do { const r = await iam.send(new ListRolesCommand({ Marker: marker })); out.push(...(r.Roles ?? [])); marker = r.IsTruncated ? r.Marker : undefined; } while (marker);
  return out.map((r) => ({ id: r.RoleName, name: r.RoleName, path: r.Path, trusted: trusted(decodeDoc(r.AssumeRolePolicyDocument)), created: r.CreateDate, lastUsed: r.RoleLastUsed?.LastUsedDate })).sort((a, b) => a.name.localeCompare(b.name));
});
---
<Console title="Roles" crumbs={[{ label: 'Roles' }]} error={post.error}>
  <PageHeader title="Roles" description="An IAM role is an identity with permissions that can be assumed by trusted entities." />
  <DataTable title="Roles" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Search roles" emptyTitle="No roles" emptyText="You don't have any IAM roles."
    columns={[
      { key: 'name', label: 'Role name', href: (r) => `/iam/roles/${encodeURIComponent(r.name)}` },
      { key: 'trusted', label: 'Trusted entities', render: (r) => (r.trusted.length ? r.trusted.map((t: string) => badge(t)) : '-'), sort: (r) => r.trusted.join() },
      { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => new Date(r.created ?? 0).getTime() },
      { key: 'lastUsed', label: 'Last used', render: (r) => (r.lastUsed ? dateTime(r.lastUsed) : '-') },
    ]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="Selected roles and their attached policies will be deleted." data-confirm-title="Delete roles?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/iam/roles/create"><Icon name="plus" size={16} /> Create role</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/iam/roles/create">Create role</a>
  </DataTable>
</Console>
