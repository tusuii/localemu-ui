---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Icon from '../../components/Icon.astro';
import { ListStateMachinesCommand, DeleteStateMachineCommand } from '@aws-sdk/client-sfn';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { dateTime, plural } from '../../lib/format';
import { badge } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const sfn = aws.sfn(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => { const ids = strs(f, 'id'); if (!ids.length) throw new UserError('Select at least one state machine.'); for (const a of ids) await sfn.send(new DeleteStateMachineCommand({ stateMachineArn: a })); return `Deleted ${plural(ids.length, 'state machine')}.`; },
});
if (post.response) return post.response;
const res = await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await sfn.send(new ListStateMachinesCommand({ nextToken: token })); out.push(...(r.stateMachines ?? [])); token = r.nextToken; } while (token);
  return out.map((s) => ({ id: s.stateMachineArn, name: s.name, type: s.type, created: s.creationDate }));
});
---
<Console title="State machines" crumbs={[{ label: 'State machines' }]} error={post.error}>
  <PageHeader title="State machines" description="Coordinate distributed applications with visual workflows." />
  <DataTable title="State machines" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Search state machines" emptyTitle="No state machines" emptyText="Create a state machine to orchestrate your services."
    columns={[{ key: 'name', label: 'Name', href: (r) => `/stepfunctions/${encodeURIComponent(r.name)}` }, { key: 'type', label: 'Type', render: (r) => badge(r.type, r.type === 'EXPRESS' ? 'blue' : 'soft') }, { key: 'created', label: 'Creation date', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => new Date(r.created ?? 0).getTime() }, { key: 'id', label: 'ARN', mono: true }]}>
    <Fragment slot="actions">
      <a class="btn btn-normal" data-href-template="/stepfunctions/{name}?tab=executions" data-min="1" data-max="1">Start execution</a>
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected state machines will be deleted. Running executions continue until they finish." data-confirm-title="Delete state machines?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/stepfunctions/create"><Icon name="plus" size={16} /> Create state machine</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/stepfunctions/create">Create state machine</a>
  </DataTable>
</Console>
