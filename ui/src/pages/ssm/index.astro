---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Icon from '../../components/Icon.astro';
import { DescribeParametersCommand, DeleteParameterCommand } from '@aws-sdk/client-ssm';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { bulk } from '../../lib/bulk';
import { UserError, load } from '../../lib/errors';
import { dateTime, plural } from '../../lib/format';
import { badge } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const ssm = aws.ssm(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => {
    return bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'parameter' }, (n) => ssm.send(new DeleteParameterCommand({ Name: n })));
  },
});
if (post.response) return post.response;

const res = await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await ssm.send(new DescribeParametersCommand({ NextToken: token, MaxResults: 50 })); out.push(...(r.Parameters ?? [])); token = r.NextToken; } while (token && out.length < 1000);
  return out.map((p) => ({ id: p.Name, name: p.Name, type: p.Type, tier: p.Tier, version: p.Version, modified: p.LastModifiedDate, description: p.Description }));
});
const rows = (res.data ?? []).sort((a: any, b: any) => a.name.localeCompare(b.name));
---
<Console title="Parameter Store" crumbs={[{ label: 'Parameter Store' }]} error={post.error}>
  <PageHeader title="Parameter Store" description="Centralised, hierarchical storage for configuration data and secrets." />
  <DataTable
    title="My parameters" rows={rows} error={res.error} select="multi" nameKey="name" pageSize={25}
    filter="Filter parameters by name or path" emptyTitle="No parameters" emptyText="You haven't created any parameters in this region."
    columns={[
      { key: 'name', label: 'Name', href: (r) => `/ssm/parameter?name=${encodeURIComponent(r.name)}` },
      { key: 'tier', label: 'Tier', render: (r) => badge(r.tier ?? 'Standard') },
      { key: 'type', label: 'Type', render: (r) => badge(r.type, r.type === 'SecureString' ? 'orange' : 'soft') },
      { key: 'version', label: 'Version' },
      { key: 'modified', label: 'Last modified', nowrap: true, render: (r) => dateTime(r.modified), sort: (r) => new Date(r.modified ?? 0).getTime() },
      { key: 'description', label: 'Description' },
    ]}
  >
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected parameters will be permanently deleted." data-confirm-title="Delete parameters?" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/ssm/create"><Icon name="plus" size={16} /> Create parameter</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/ssm/create">Create parameter</a>
  </DataTable>
</Console>
