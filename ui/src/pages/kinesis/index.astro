---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Card from '../../components/Card.astro';
import { ListStreamsCommand, DescribeStreamSummaryCommand, CreateStreamCommand, DeleteStreamCommand } from '@aws-sdk/client-kinesis';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, intOf, required, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { dateTime, plural } from '../../lib/format';
import { stateStatus } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const k = aws.kinesis(ctx);
const post = await handlePost(Astro, {
  create: async (f) => { const n = required(f, 'name', 'Stream name'); await k.send(new CreateStreamCommand({ StreamName: n, ShardCount: intOf(f, 'shards', 'Shard count') ?? 1 })); return { message: `Stream ${n} created.`, redirect: `/kinesis/${encodeURIComponent(n)}` }; },
  delete: async (f) => { const ids = strs(f, 'id'); if (!ids.length) throw new UserError('Select at least one stream.'); for (const s of ids) await k.send(new DeleteStreamCommand({ StreamName: s, EnforceConsumerDeletion: true })); return `Deleted ${plural(ids.length, 'stream')}.`; },
});
if (post.response) return post.response;
const res = await load(async () => {
  const names: string[] = []; let tok: string | undefined;
  do { const r = await k.send(new ListStreamsCommand({ NextToken: tok })); names.push(...(r.StreamNames ?? [])); tok = r.HasMoreStreams ? r.NextToken : undefined; } while (tok);
  return Promise.all(names.map(async (n) => { const d = (await k.send(new DescribeStreamSummaryCommand({ StreamName: n })).catch(() => undefined))?.StreamDescriptionSummary; return { id: n, name: n, status: d?.StreamStatus, shards: d?.OpenShardCount, retention: d?.RetentionPeriodHours, created: d?.StreamCreationTimestamp, mode: d?.StreamModeDetails?.StreamMode }; }));
});
---
<Console title="Data streams" crumbs={[{ label: 'Data streams' }]} error={post.error}>
  <PageHeader title="Data streams" description="Capture and process streaming data in real time." />
  <DataTable title="Data streams" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Search streams" emptyTitle="No data streams" emptyText="Create one below."
    columns={[{ key: 'name', label: 'Name', href: (r) => `/kinesis/${encodeURIComponent(r.name)}` }, { key: 'status', label: 'Status', render: (r) => stateStatus(r.status) }, { key: 'shards', label: 'Open shards' }, { key: 'retention', label: 'Retention', render: (r) => (r.retention ? `${r.retention} h` : '-') }, { key: 'created', label: 'Created', render: (r) => dateTime(r.created) }]}>
    <button slot="actions" class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected streams and their data will be deleted." data-confirm-title="Delete streams?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
  </DataTable>
  <Card class="mt-4" title="Create data stream"><form method="post" class="flex max-w-2xl items-end gap-2"><input type="hidden" name="intent" value="create" />
    <div class="flex-1"><label class="field-label" for="n">Stream name</label><input id="n" name="name" class="input" required autocomplete="off" /></div><div class="w-32"><label class="field-label" for="s">Shards</label><input id="s" name="shards" type="number" min="1" value="1" class="input" /></div><button class="btn btn-primary" type="submit">Create</button></form></Card>
</Console>
