---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Icon from '../../components/Icon.astro';
import { ListUserPoolsCommand, DescribeUserPoolCommand, DeleteUserPoolCommand } from '@aws-sdk/client-cognito-identity-provider';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { dateTime, num, plural } from '../../lib/format';
import { mono } from '../../lib/html';
import { listAll } from '../../lib/cognito';

const ctx = getCtx(Astro.cookies);
const cognito = aws.cognito(ctx);

const post = await handlePost(Astro, {
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one user pool.');
    for (const id of ids) await cognito.send(new DeleteUserPoolCommand({ UserPoolId: id }));
    return `Deleted ${plural(ids.length, 'user pool')}.`;
  },
});
if (post.response) return post.response;

const res = await load(async () => {
  const pools = await listAll(async (t) => {
    const r = await cognito.send(new ListUserPoolsCommand({ MaxResults: 60, NextToken: t }));
    return { items: r.UserPools ?? [], next: r.NextToken };
  });
  return Promise.all(pools.map(async (p) => {
    const d = (await cognito.send(new DescribeUserPoolCommand({ UserPoolId: p.Id! })).catch(() => undefined))?.UserPool;
    return { id: p.Id!, name: p.Name ?? p.Id!, created: p.CreationDate, users: d?.EstimatedNumberOfUsers, mfa: d?.MfaConfiguration ?? 'OFF' };
  }));
});
const rows = (res.data ?? []).sort((a, b) => a.name.localeCompare(b.name));
---
<Console title="User pools" crumbs={[{ label: 'User pools' }]} error={post.error}>
  <PageHeader title="User pools" description="Amazon Cognito user pools manage sign-up, sign-in and access control for your applications." />
  <DataTable
    title="User pools" rows={rows} error={res.error} select="multi" idKey="id" nameKey="name" pageSize={25}
    filter="Search user pools" emptyTitle="No user pools" emptyText="You don't have any user pools in this region."
    columns={[
      { key: 'name', label: 'User pool name', href: (r) => `/cognito-idp/${encodeURIComponent(r.id)}` },
      { key: 'id', label: 'User pool ID', render: (r) => mono(r.id) },
      { key: 'users', label: 'Users', render: (r) => num(r.users ?? 0), sort: (r) => r.users ?? 0 },
      { key: 'mfa', label: 'MFA' },
      { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => r.created?.getTime() ?? 0 },
    ]}
  >
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected user pools, their users, groups and app clients will be permanently deleted." data-confirm-title="Delete user pools?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/cognito-idp/create"><Icon name="plus" size={16} /> Create user pool</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/cognito-idp/create">Create user pool</a>
  </DataTable>
</Console>
