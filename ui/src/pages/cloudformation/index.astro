---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Icon from '../../components/Icon.astro';
import { DescribeStacksCommand, DeleteStackCommand } from '@aws-sdk/client-cloudformation';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { dateTime, plural } from '../../lib/format';
import { stateStatus } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const cfn = aws.cfn(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => { const ids = strs(f, 'id'); if (!ids.length) throw new UserError('Select at least one stack.'); for (const s of ids) await cfn.send(new DeleteStackCommand({ StackName: s })); return `Deleting ${plural(ids.length, 'stack')}.`; },
});
if (post.response) return post.response;
const res = await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await cfn.send(new DescribeStacksCommand({ NextToken: token })); out.push(...(r.Stacks ?? [])); token = r.NextToken; } while (token);
  return out.filter((s) => s.StackStatus !== 'DELETE_COMPLETE').map((s) => ({ id: s.StackName, name: s.StackName, status: s.StackStatus, created: s.CreationTime, updated: s.LastUpdatedTime, description: s.Description }));
});
---
<Console title="Stacks" crumbs={[{ label: 'Stacks' }]} error={post.error}>
  <PageHeader title="Stacks" description="Provision and manage resources as code with CloudFormation templates." />
  <DataTable title="Stacks" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Filter by stack name" emptyTitle="No stacks" emptyText="Create a stack from a template."
    columns={[
      { key: 'name', label: 'Stack name', href: (r) => `/cloudformation/${encodeURIComponent(r.name)}` }, { key: 'status', label: 'Status', render: (r) => stateStatus(r.status) },
      { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => new Date(r.created ?? 0).getTime() }, { key: 'description', label: 'Description' },
    ]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected stacks and the resources they created will be deleted." data-confirm-title="Delete stacks?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/cloudformation/create"><Icon name="plus" size={16} /> Create stack</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/cloudformation/create">Create stack</a>
  </DataTable>
</Console>
