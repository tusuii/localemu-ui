---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import Icon from '../../../components/Icon.astro';
import { DescribeTargetGroupsCommand, DeleteTargetGroupCommand } from '@aws-sdk/client-elastic-load-balancing-v2';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, strs } from '../../../lib/action';
import { UserError, load } from '../../../lib/errors';
import { plural } from '../../../lib/format';
import { badge } from '../../../lib/html';
import { lbShort, uniq } from '../../../lib/elbv2';

const ctx = getCtx(Astro.cookies);
const elb = aws.elbv2(ctx);

const post = await handlePost(Astro, {
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one target group.');
    for (const arn of ids) await elb.send(new DeleteTargetGroupCommand({ TargetGroupArn: arn }));
    return `Deleted ${plural(ids.length, 'target group')}.`;
  },
});
if (post.response) return post.response;

const res = await load(async () => {
  const out: any[] = []; let marker: string | undefined;
  do { const r = await elb.send(new DescribeTargetGroupsCommand({ Marker: marker })); out.push(...(r.TargetGroups ?? [])); marker = r.NextMarker; } while (marker);
  return out.map((t) => ({
    id: t.TargetGroupArn, name: t.TargetGroupName, port: t.Port, protocol: t.Protocol, type: t.TargetType, vpc: t.VpcId,
    lbs: uniq<string>(t.LoadBalancerArns).map((a) => lbShort(a)).join(', '), health: t.HealthCheckPath ?? t.HealthCheckProtocol,
  }));
});
const rows = (res.data ?? []).sort((a, b) => a.name.localeCompare(b.name));
---
<Console title="Target groups" crumbs={[{ label: 'Target groups' }]} error={post.error}>
  <PageHeader title="Target groups" description="Target groups route requests to registered targets such as instances, IP addresses or Lambda functions." />
  <DataTable
    title="Target groups" rows={rows} error={res.error} select="multi" nameKey="name" pageSize={25}
    filter="Filter target groups" emptyTitle="No target groups" emptyText="You don't have any target groups in this region."
    columns={[
      { key: 'name', label: 'Name', href: (r) => `/elbv2/target-groups/${encodeURIComponent(r.name)}` },
      { key: 'port', label: 'Port' },
      { key: 'protocol', label: 'Protocol', render: (r) => (r.protocol ? badge(r.protocol) : '-') },
      { key: 'type', label: 'Target type' },
      { key: 'lbs', label: 'Load balancer', render: (r) => r.lbs || 'None associated' },
      { key: 'vpc', label: 'VPC ID', mono: true },
      { key: 'health', label: 'Health check' },
    ]}
  >
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected target groups will be permanently deleted." data-confirm-title="Delete target groups?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/elbv2/target-groups/create"><Icon name="plus" size={16} /> Create target group</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/elbv2/target-groups/create">Create target group</a>
  </DataTable>
</Console>
