---
import Console from '../../../../layouts/Console.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Card from '../../../../components/Card.astro';
import Details from '../../../../components/Details.astro';
import DataTable from '../../../../components/DataTable.astro';
import Icon from '../../../../components/Icon.astro';
import { GetTableCommand, GetPartitionsCommand, DeleteTableCommand } from '@aws-sdk/client-glue';
import { aws } from '../../../../lib/aws';
import { getCtx } from '../../../../lib/context';
import { handlePost } from '../../../../lib/action';
import { load, soft } from '../../../../lib/errors';
import { dateTime } from '../../../../lib/format';
import { badge, copyable, link, mono } from '../../../../lib/html';
import { formatOf, isNoSuch } from '../../../../lib/glue';

const { db, table } = Astro.params as { db: string; table: string };
const ctx = getCtx(Astro.cookies);
const glue = aws.glue(ctx);

const post = await handlePost(Astro, {
  delete: async () => { await glue.send(new DeleteTableCommand({ DatabaseName: db, Name: table })); return { message: `Deleted table "${table}".`, redirect: `/glue/tables?db=${encodeURIComponent(db)}` }; },
});
if (post.response) return post.response;

const res = await load(async () => (await glue.send(new GetTableCommand({ DatabaseName: db, Name: table }))).Table!);
if (isNoSuch(res.error)) return new Response(`Table "${db}.${table}" does not exist`, { status: 404 });
const t = res.data;
const sd = t?.StorageDescriptor;
const parts = await soft(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await glue.send(new GetPartitionsCommand({ DatabaseName: db, TableName: table, NextToken: token })); out.push(...(r.Partitions ?? [])); token = r.NextToken; } while (token && out.length < 500);
  return out.map((p) => ({ id: (p.Values ?? []).join('/'), values: (p.Values ?? []).join(', '), location: p.StorageDescriptor?.Location, created: p.CreationTime }));
});
const params = Object.entries(t?.Parameters ?? {}).map(([k, v]) => ({ id: k, key: k, value: v }));
---
<Console title={table} crumbs={[{ label: 'Tables', href: `/glue/tables?db=${encodeURIComponent(db)}` }, { label: table }]} error={post.error ?? res.error}>
  <PageHeader title={table} badge={formatOf(sd)} description={`Database: ${db}`} />
  {t && (
    <div class="space-y-4">
      <Card title="Table overview">
        <Details items={[
          { label: 'Name', value: t.Name }, { label: 'Database', value: link(`/glue/tables?db=${encodeURIComponent(db)}`, db) }, { label: 'Table type', value: t.TableType },
          { label: 'Location', value: sd?.Location ? copyable(sd.Location) : undefined, wide: true },
          { label: 'Input format', value: sd?.InputFormat ? mono(sd.InputFormat) : undefined, wide: true }, { label: 'Output format', value: sd?.OutputFormat ? mono(sd.OutputFormat) : undefined, wide: true },
          { label: 'SerDe library', value: sd?.SerdeInfo?.SerializationLibrary ? mono(sd.SerdeInfo.SerializationLibrary) : undefined, wide: true },
          { label: 'Description', value: t.Description }, { label: 'Created', value: dateTime(t.CreateTime) }, { label: 'Version', value: t.VersionId },
        ]} />
      </Card>
      <DataTable title="Schema" rows={(sd?.Columns ?? []).map((c, i) => ({ id: c.Name, n: i + 1, name: c.Name, type: c.Type, comment: c.Comment }))} filter={false} refresh={false} id="schema" pageSize={50}
        emptyTitle="No columns" emptyText="This table has no columns."
        columns={[{ key: 'n', label: '#' }, { key: 'name', label: 'Column name', mono: true }, { key: 'type', label: 'Data type', render: (r) => badge(r.type) }, { key: 'comment', label: 'Comment' }]} />
      <DataTable title="Partition keys" rows={(t.PartitionKeys ?? []).map((c, i) => ({ id: c.Name, n: i + 1, name: c.Name, type: c.Type }))} filter={false} refresh={false} id="pkeys" pageSize={50}
        emptyTitle="Not partitioned" emptyText="This table has no partition keys."
        columns={[{ key: 'n', label: '#' }, { key: 'name', label: 'Partition key', mono: true }, { key: 'type', label: 'Data type', render: (r) => badge(r.type) }]} />
      {(t.PartitionKeys ?? []).length > 0 && (
        <DataTable title="Partitions" rows={parts.value ?? []} error={parts.error} id="parts" pageSize={20} filter="Filter partitions"
          emptyTitle="No partitions" emptyText="No partitions have been added to this table."
          columns={[{ key: 'values', label: 'Values', mono: true }, { key: 'location', label: 'Location', mono: true }, { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created) }]} />
      )}
      <DataTable title="Table properties" rows={params} filter={false} refresh={false} id="props" pageSize={50} emptyTitle="No properties" emptyText="This table has no properties."
        columns={[{ key: 'key', label: 'Key', mono: true }, { key: 'value', label: 'Value' }]} />
      <Card title="Delete table">
        <form method="post"><input type="hidden" name="intent" value="delete" />
          <button class="btn btn-danger" data-confirm="The table will be removed from the Data Catalog. Data in S3 is not deleted." data-confirm-title="Delete table?" data-confirm-name={table} data-confirm-type="delete" data-confirm-ok="Delete table"><Icon name="trash-2" size={16} /> Delete table</button></form>
      </Card>
    </div>
  )}
</Console>
