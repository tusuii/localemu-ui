---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import FormField from '../../../components/FormField.astro';
import Icon from '../../../components/Icon.astro';
import { GetDatabasesCommand, GetTablesCommand, DeleteTableCommand } from '@aws-sdk/client-glue';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, required, strs } from '../../../lib/action';
import { UserError, load } from '../../../lib/errors';
import { dateTime, plural } from '../../../lib/format';
import { badge } from '../../../lib/html';
import { formatOf } from '../../../lib/glue';

const ctx = getCtx(Astro.cookies);
const glue = aws.glue(ctx);
const dbs = await load(async () => ((await glue.send(new GetDatabasesCommand({}))).DatabaseList ?? []).map((d) => d.Name!).sort());
const db = Astro.url.searchParams.get('db') || dbs.data?.[0] || '';

const post = await handlePost(Astro, {
  delete: async (f) => {
    const database = required(f, 'db', 'Database');
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one table.');
    for (const n of ids) await glue.send(new DeleteTableCommand({ DatabaseName: database, Name: n }));
    return { message: `Deleted ${plural(ids.length, 'table')}.`, redirect: `/glue/tables?db=${encodeURIComponent(database)}` };
  },
});
if (post.response) return post.response;

const res = db ? await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await glue.send(new GetTablesCommand({ DatabaseName: db, NextToken: token })); out.push(...(r.TableList ?? [])); token = r.NextToken; } while (token);
  return out.map((t) => ({
    id: t.Name, name: t.Name, db: t.DatabaseName ?? db, location: t.StorageDescriptor?.Location, format: formatOf(t.StorageDescriptor), classification: t.Parameters?.classification,
    columns: (t.StorageDescriptor?.Columns ?? []).length, partitions: (t.PartitionKeys ?? []).length, type: t.TableType, created: t.CreateTime,
  }));
}) : undefined;
const rows = (res?.data ?? []).sort((a, b) => a.name.localeCompare(b.name));
---
<Console title="Tables" crumbs={[{ label: 'Tables' }]} error={post.error ?? dbs.error}>
  <PageHeader title="Tables" description="Tables describe the schema and location of your data in the Glue Data Catalog." />
  <form method="get" class="mb-4 flex items-end gap-3">
    <FormField label="Database" for="db" class="!mb-0 min-w-[280px]"><select id="db" name="db" class="select" onchange="this.form.submit()">{(dbs.data ?? []).map((d) => <option value={d} selected={d === db}>{d}</option>)}</select></FormField>
    <noscript><button class="btn btn-normal" type="submit">Show</button></noscript>
  </form>
  {!db && !dbs.error ? (
    <div class="card"><div class="empty"><h3>No databases</h3><p>Create a database first, then add tables to it.</p><div class="mt-4"><a class="btn btn-primary" href="/glue">Go to databases</a></div></div></div>
  ) : (
    <DataTable
      title="Tables" rows={rows} error={res?.error} select="multi" nameKey="name" pageSize={25}
      filter="Filter tables" emptyTitle="No tables" emptyText={`The database ${db} has no tables.`}
      columns={[
        { key: 'name', label: 'Name', href: (r) => `/glue/tables/${encodeURIComponent(db)}/${encodeURIComponent(r.name)}` },
        { key: 'db', label: 'Database' },
        { key: 'location', label: 'Location', mono: true },
        { key: 'format', label: 'Format', render: (r) => badge(r.format) },
        { key: 'columns', label: 'Columns' },
        { key: 'partitions', label: 'Partition keys' },
        { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => r.created?.getTime() ?? 0 },
      ]}
    >
      <Fragment slot="actions">
        <input type="hidden" name="db" value={db} />
        <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected tables will be removed from the Data Catalog. Data in S3 is not deleted." data-confirm-title="Delete tables?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
        <a class="btn btn-primary" href={`/glue/tables/create?db=${encodeURIComponent(db)}`}><Icon name="plus" size={16} /> Create table</a>
      </Fragment>
      <a slot="empty" class="btn btn-primary" href={`/glue/tables/create?db=${encodeURIComponent(db)}`}>Create table</a>
    </DataTable>
  )}
</Console>
