---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Card from '../../components/Card.astro';
import FormField from '../../components/FormField.astro';
import { GetDatabasesCommand, CreateDatabaseCommand, DeleteDatabaseCommand } from '@aws-sdk/client-glue';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, required, str, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { dateTime, plural } from '../../lib/format';

const ctx = getCtx(Astro.cookies);
const glue = aws.glue(ctx);

const post = await handlePost(Astro, {
  create: async (f) => {
    const name = required(f, 'name', 'Database name');
    if (!/^[a-z0-9_]{1,255}$/.test(name)) throw new UserError('Database names are lowercase letters, numbers and underscores.');
    const loc = str(f, 'location');
    await glue.send(new CreateDatabaseCommand({ DatabaseInput: { Name: name, Description: str(f, 'description') || undefined, LocationUri: loc || undefined } }));
    return `Database ${name} created.`;
  },
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one database.');
    for (const n of ids) await glue.send(new DeleteDatabaseCommand({ Name: n }));
    return `Deleted ${plural(ids.length, 'database')}.`;
  },
});
if (post.response) return post.response;

const res = await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await glue.send(new GetDatabasesCommand({ NextToken: token })); out.push(...(r.DatabaseList ?? [])); token = r.NextToken; } while (token);
  return out.map((d) => ({ id: d.Name, name: d.Name, description: d.Description, location: d.LocationUri, created: d.CreateTime }));
});
const rows = (res.data ?? []).sort((a, b) => a.name.localeCompare(b.name));
const v = post.values;
---
<Console title="Databases" crumbs={[{ label: 'Databases' }]} error={post.error}>
  <PageHeader title="Databases" description="AWS Glue databases organize the tables of the Data Catalog." />
  <div class="space-y-4">
    <DataTable
      title="Databases" rows={rows} error={res.error} select="multi" nameKey="name" pageSize={25}
      filter="Filter databases" emptyTitle="No databases" emptyText="Create a database below to start cataloging your data."
      columns={[
        { key: 'name', label: 'Name', href: (r) => `/glue/tables?db=${encodeURIComponent(r.name)}` },
        { key: 'description', label: 'Description' },
        { key: 'location', label: 'Location URI', mono: true },
        { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => r.created?.getTime() ?? 0 },
      ]}
    >
      <Fragment slot="actions">
        <a class="btn btn-normal" data-href-template="/glue/tables?db={name}" data-min="1" data-max="1">View tables</a>
        <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected databases and all of their tables will be permanently deleted." data-confirm-title="Delete databases?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      </Fragment>
    </DataTable>

    <Card title="Create database">
      <form method="post" class="grid gap-4 md:grid-cols-[1fr_1fr_1fr_auto] md:items-end">
        <input type="hidden" name="intent" value="create" />
        <FormField label="Name" for="name" class="!mb-0"><input id="name" name="name" class="input" required autocomplete="off" value={v.name ?? ''} /></FormField>
        <FormField label="Description" for="description" optional class="!mb-0"><input id="description" name="description" class="input" value={v.description ?? ''} /></FormField>
        <FormField label="Location" for="location" optional class="!mb-0"><input id="location" name="location" class="input" placeholder="s3://bucket/path/" value={v.location ?? ''} /></FormField>
        <button class="btn btn-primary" type="submit">Create database</button>
      </form>
    </Card>
  </div>
</Console>
