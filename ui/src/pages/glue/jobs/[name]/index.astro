---
import Console from '../../../../layouts/Console.astro';
import PageHeader from '../../../../components/PageHeader.astro';
import Card from '../../../../components/Card.astro';
import Details from '../../../../components/Details.astro';
import DataTable from '../../../../components/DataTable.astro';
import Icon from '../../../../components/Icon.astro';
import { GetJobCommand, GetJobRunsCommand, StartJobRunCommand, BatchStopJobRunCommand, DeleteJobCommand } from '@aws-sdk/client-glue';
import { aws } from '../../../../lib/aws';
import { getCtx } from '../../../../lib/context';
import { handlePost, strs } from '../../../../lib/action';
import { UserError, load } from '../../../../lib/errors';
import { dateTime, duration } from '../../../../lib/format';
import { copyable, mono, stateStatus } from '../../../../lib/html';
import { isNoSuch, roleName } from '../../../../lib/glue';

const name = Astro.params.name!;
const ctx = getCtx(Astro.cookies);
const glue = aws.glue(ctx);

const post = await handlePost(Astro, {
  run: async () => { const r = await glue.send(new StartJobRunCommand({ JobName: name })); return { message: 'Job run started.', detail: `Run ID: ${r.JobRunId}` }; },
  stop: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one run.');
    await glue.send(new BatchStopJobRunCommand({ JobName: name, JobRunIds: ids }));
    return `Stop requested for ${ids.length} run${ids.length > 1 ? 's' : ''}.`;
  },
  delete: async () => { await glue.send(new DeleteJobCommand({ JobName: name })); return { message: `Deleted job "${name}".`, redirect: '/glue/jobs' }; },
});
if (post.response) return post.response;

const jobRes = await load(async () => (await glue.send(new GetJobCommand({ JobName: name }))).Job!);
if (isNoSuch(jobRes.error) || (!jobRes.error && !jobRes.data?.Name)) return new Response(`Job "${name}" does not exist`, { status: 404 });
const job = jobRes.data;
const runs = await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await glue.send(new GetJobRunsCommand({ JobName: name, NextToken: token })); out.push(...(r.JobRuns ?? [])); token = r.NextToken; } while (token && out.length < 200);
  return out.map((r) => ({ id: r.Id, run: r.Id, state: r.JobRunState, started: r.StartedOn, completed: r.CompletedOn, secs: r.ExecutionTime, error: r.ErrorMessage, attempt: r.Attempt }))
    .sort((a, b) => (b.started?.getTime() ?? 0) - (a.started?.getTime() ?? 0));
});
---
<Console title={name} crumbs={[{ label: 'Jobs', href: '/glue/jobs' }, { label: name }]} error={post.error ?? jobRes.error}>
  <PageHeader title={name} badge={job?.Command?.Name}>
    <form method="post"><input type="hidden" name="intent" value="run" /><button class="btn btn-primary" type="submit"><Icon name="play" size={16} /> Run job</button></form>
  </PageHeader>
  {job && (
    <div class="space-y-4">
      <Card title="Job details">
        <Details items={[
          { label: 'Name', value: job.Name }, { label: 'Type', value: job.Command?.Name }, { label: 'Glue version', value: job.GlueVersion },
          { label: 'Script location', value: job.Command?.ScriptLocation ? copyable(job.Command.ScriptLocation) : undefined, wide: true },
          { label: 'IAM role', value: roleName(job.Role) }, { label: 'Worker type', value: job.WorkerType }, { label: 'Number of workers', value: job.NumberOfWorkers },
          { label: 'Description', value: job.Description }, { label: 'Created', value: dateTime(job.CreatedOn) }, { label: 'Last modified', value: dateTime(job.LastModifiedOn) },
        ]} />
      </Card>
      <DataTable title="Job runs" rows={runs.data ?? []} error={runs.error} select="multi" idKey="id" nameKey="run" id="runs" pageSize={20} filter="Filter runs"
        emptyTitle="No runs" emptyText="Run the job to see its history here."
        columns={[
          { key: 'run', label: 'Run ID', render: (r) => mono(r.run) },
          { key: 'state', label: 'Run status', render: (r) => stateStatus(r.state, { succeeded: 'success', running: 'progress', starting: 'progress', stopping: 'progress', stopped: 'stopped', failed: 'error', timeout: 'error' }) },
          { key: 'started', label: 'Started', nowrap: true, render: (r) => dateTime(r.started), sort: (r) => r.started?.getTime() ?? 0 },
          { key: 'completed', label: 'Completed', nowrap: true, render: (r) => (r.completed ? dateTime(r.completed) : '-') },
          { key: 'secs', label: 'Duration', render: (r) => (r.secs === undefined ? '-' : duration(r.secs)) },
          { key: 'error', label: 'Error' },
        ]}>
        <button slot="actions" class="btn btn-normal" name="intent" value="stop" data-min="1" data-confirm="Selected runs that are still running will be stopped." data-confirm-title="Stop runs?" data-confirm-ok="Stop run">Stop run</button>
      </DataTable>
      <Card title="Delete job">
        <form method="post"><input type="hidden" name="intent" value="delete" />
          <button class="btn btn-danger" data-confirm="The job and its run history will be permanently deleted." data-confirm-title="Delete job?" data-confirm-name={name} data-confirm-type="delete" data-confirm-ok="Delete job"><Icon name="trash-2" size={16} /> Delete job</button></form>
      </Card>
    </div>
  )}
</Console>
