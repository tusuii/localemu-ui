---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Icon from '../../components/Icon.astro';
import Pager from '../../components/Pager.astro';
import { pageLinks, pageState } from '../../lib/paging';
import { ListFunctionsCommand, DeleteFunctionCommand } from '@aws-sdk/client-lambda';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { bulk } from '../../lib/bulk';
import { UserError, load } from '../../lib/errors';
import { bytes, dateTime, plural } from '../../lib/format';
import { badge, stateStatus } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const lambda = aws.lambda(ctx);

const post = await handlePost(Astro, {
  delete: async (f) => {
    return bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'function' }, (n) => lambda.send(new DeleteFunctionCommand({ FunctionName: n })));
  },
});
if (post.response) return post.response;

const state = pageState(Astro.url);
const size = [25, 50, 100].includes(Number(Astro.url.searchParams.get('limit'))) ? Number(Astro.url.searchParams.get('limit')) : 50;
let nextMarker: string | undefined;
const res = await load(async () => {
  const r = await lambda.send(new ListFunctionsCommand({ Marker: state.token as string | undefined, MaxItems: size }));
  nextMarker = r.NextMarker;
  return (r.Functions ?? []).map((f) => ({ id: f.FunctionName, name: f.FunctionName, runtime: f.Runtime ?? f.PackageType, handler: f.Handler, memory: f.MemorySize, timeout: f.Timeout, size: f.CodeSize, modified: f.LastModified, state: f.State ?? 'Active', pkg: f.PackageType }));
});
const links = pageLinks(Astro.url, state, nextMarker);
const rows = (res.data ?? []).sort((a: any, b: any) => a.name.localeCompare(b.name));
---
<Console title="Functions" crumbs={[{ label: 'Functions' }]} error={post.error}>
  <PageHeader title="Functions" description="Run code in response to events without provisioning servers." />
  <DataTable
    title="Functions" rows={rows} error={res.error} select="multi" nameKey="name" pageSize={25}
    filter="Filter by attributes or search by keyword" emptyTitle="No functions" emptyText="You haven't created any Lambda functions in this region."
    columns={[
      { key: 'name', label: 'Function name', href: (r) => `/lambda/${encodeURIComponent(r.name)}` },
      { key: 'pkg', label: 'Package', render: (r) => badge(r.pkg ?? 'Zip') },
      { key: 'runtime', label: 'Runtime' },
      { key: 'handler', label: 'Handler', mono: true },
      { key: 'memory', label: 'Memory', render: (r) => `${r.memory} MB`, sort: (r) => r.memory },
      { key: 'timeout', label: 'Timeout', render: (r) => `${r.timeout} s`, sort: (r) => r.timeout },
      { key: 'size', label: 'Code size', render: (r) => bytes(r.size), sort: (r) => r.size },
      { key: 'modified', label: 'Last modified', nowrap: true, render: (r) => dateTime(r.modified), sort: (r) => r.modified },
      { key: 'state', label: 'State', render: (r) => stateStatus(r.state) },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn btn-normal" data-href-template="/lambda/{id}?tab=test" data-min="1" data-max="1">Test</a>
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected functions will be permanently deleted." data-confirm-title="Delete functions?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/lambda/create"><Icon name="plus" size={16} /> Create function</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/lambda/create">Create function</a>
  </DataTable>
  {!res.error && (rows.length > 0 || links.index > 0) && <div class="card -mt-3 rounded-t-none"><Pager links={links} count={rows.length} noun="functions" /></div>}
</Console>
