---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import Icon from '../../../components/Icon.astro';
import { ListWorkGroupsCommand, GetWorkGroupCommand, DeleteWorkGroupCommand } from '@aws-sdk/client-athena';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, strs } from '../../../lib/action';
import { UserError, load } from '../../../lib/errors';
import { dateTime, plural } from '../../../lib/format';
import { stateStatus } from '../../../lib/html';

const ctx = getCtx(Astro.cookies);
const athena = aws.athena(ctx);

const post = await handlePost(Astro, {
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one workgroup.');
    if (ids.includes('primary')) throw new UserError('The primary workgroup cannot be deleted.');
    for (const n of ids) await athena.send(new DeleteWorkGroupCommand({ WorkGroup: n, RecursiveDeleteOption: true }));
    return `Deleted ${plural(ids.length, 'workgroup')}.`;
  },
});
if (post.response) return post.response;

const res = await load(async () => {
  const list = (await athena.send(new ListWorkGroupsCommand({}))).WorkGroups ?? [];
  return Promise.all(list.map(async (w) => {
    const d = (await athena.send(new GetWorkGroupCommand({ WorkGroup: w.Name! })).catch(() => undefined))?.WorkGroup;
    return { id: w.Name!, name: w.Name!, state: w.State, description: w.Description || d?.Description, output: d?.Configuration?.ResultConfiguration?.OutputLocation, created: w.CreationTime };
  }));
});
const rows = (res.data ?? []).sort((a, b) => a.name.localeCompare(b.name));
---
<Console title="Workgroups" crumbs={[{ label: 'Workgroups' }]} error={post.error}>
  <PageHeader title="Workgroups" description="Workgroups separate query execution, history and settings between teams and workloads." />
  <DataTable
    title="Workgroups" rows={rows} error={res.error} select="multi" nameKey="name" pageSize={25}
    filter="Find workgroups" emptyTitle="No workgroups" emptyText="Create a workgroup to organize queries."
    columns={[
      { key: 'name', label: 'Name', href: (r) => `/athena/workgroups/${encodeURIComponent(r.name)}` },
      { key: 'state', label: 'State', render: (r) => stateStatus(r.state) },
      { key: 'description', label: 'Description' },
      { key: 'output', label: 'Query result location', mono: true },
      { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => r.created?.getTime() ?? 0 },
    ]}
  >
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected workgroups and their saved queries will be permanently deleted." data-confirm-title="Delete workgroups?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/athena/workgroups/create"><Icon name="plus" size={16} /> Create workgroup</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/athena/workgroups/create">Create workgroup</a>
  </DataTable>
</Console>
