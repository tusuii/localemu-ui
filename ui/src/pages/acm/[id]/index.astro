---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import Details from '../../../components/Details.astro';
import Card from '../../../components/Card.astro';
import DataTable from '../../../components/DataTable.astro';
import FormField from '../../../components/FormField.astro';
import Icon from '../../../components/Icon.astro';
import { DescribeCertificateCommand, DeleteCertificateCommand, ListTagsForCertificateCommand, AddTagsToCertificateCommand, RemoveTagsFromCertificateCommand } from '@aws-sdk/client-acm';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, required, str, strs } from '../../../lib/action';
import { UserError, load, soft } from '../../../lib/errors';
import { dateTime } from '../../../lib/format';
import { copyable, mono, stateStatus } from '../../../lib/html';

const id = Astro.params.id!;
const ctx = getCtx(Astro.cookies);
const acm = aws.acm(ctx);
const arn = `arn:aws:acm:${ctx.region}:${ctx.account}:certificate/${id}`;

const post = await handlePost(Astro, {
  addTag: async (f) => { await acm.send(new AddTagsToCertificateCommand({ CertificateArn: arn, Tags: [{ Key: required(f, 'key', 'Tag key'), Value: str(f, 'value') }] })); return 'Tag added.'; },
  removeTag: async (f) => {
    const keys = strs(f, 'id');
    if (!keys.length) throw new UserError('Select at least one tag.');
    await acm.send(new RemoveTagsFromCertificateCommand({ CertificateArn: arn, Tags: keys.map((Key) => ({ Key })) }));
    return `Removed ${keys.length} tag${keys.length > 1 ? 's' : ''}.`;
  },
  deleteCert: async () => { await acm.send(new DeleteCertificateCommand({ CertificateArn: arn })); return { message: 'Certificate deleted.', redirect: '/acm' }; },
});
if (post.response) return post.response;

const res = await load(async () => (await acm.send(new DescribeCertificateCommand({ CertificateArn: arn }))).Certificate!);
if (res.error && /NotFound|not found|does not exist/i.test(res.error)) return new Response(`Certificate "${id}" does not exist`, { status: 404 });
const c = res.data;
const tags = await soft(async () => (await acm.send(new ListTagsForCertificateCommand({ CertificateArn: arn }))).Tags ?? []);
const dvo = (c?.DomainValidationOptions ?? []).map((d) => ({
  id: d.DomainName, domain: d.DomainName, status: d.ValidationStatus, method: d.ValidationMethod, name: d.ResourceRecord?.Name, type: d.ResourceRecord?.Type, value: d.ResourceRecord?.Value,
}));
const title = c?.DomainName ?? id;
---
<Console title={title} crumbs={[{ label: 'Certificates', href: '/acm' }, { label: title }]} error={post.error ?? res.error}>
  <PageHeader title={title} badge={c?.Type === 'IMPORTED' ? 'Imported' : 'Amazon issued'} />
  {c && (
    <div class="space-y-4">
      <Card title="Certificate status">
        <Details items={[
          { label: 'Identifier', value: copyable(id) }, { label: 'Status', value: stateStatus(c.Status, { pending_validation: 'pending' }) },
          { label: 'ARN', value: copyable(arn), wide: true },
          { label: 'Domain name', value: c.DomainName }, { label: 'Type', value: c.Type }, { label: 'In use', value: (c.InUseBy ?? []).length ? 'Yes' : 'No' },
          { label: 'Subject', value: c.Subject }, { label: 'Issuer', value: c.Issuer }, { label: 'Key algorithm', value: c.KeyAlgorithm },
          { label: 'Signature algorithm', value: c.SignatureAlgorithm }, { label: 'Serial number', value: c.Serial ? mono(c.Serial) : undefined },
          { label: 'Requested at', value: c.CreatedAt ? dateTime(c.CreatedAt) : undefined }, { label: 'Imported at', value: c.ImportedAt ? dateTime(c.ImportedAt) : undefined },
          { label: 'Issued at', value: c.IssuedAt ? dateTime(c.IssuedAt) : undefined },
          { label: 'Not before', value: c.NotBefore ? dateTime(c.NotBefore) : undefined }, { label: 'Not after', value: c.NotAfter ? dateTime(c.NotAfter) : undefined },
          { label: 'Renewal eligibility', value: c.RenewalEligibility },
          { label: 'Subject alternative names', value: (c.SubjectAlternativeNames ?? []).join(', '), wide: true },
        ]} />
      </Card>

      <Card title="Domains" flush>
        <DataTable title="Domain validation" bare filter={false} refresh={false} id="dvo" rows={dvo} pageSize={50} emptyTitle="No domain validation records" emptyText="This certificate has no validation records."
          columns={[
            { key: 'domain', label: 'Domain' },
            { key: 'status', label: 'Validation status', render: (r) => stateStatus(r.status, { pending_validation: 'pending', success: 'success' }) },
            { key: 'method', label: 'Method' },
            { key: 'name', label: 'CNAME name', mono: true },
            { key: 'type', label: 'Type' },
            { key: 'value', label: 'CNAME value', mono: true },
          ]} />
      </Card>

      <Card title="In use by" count={(c.InUseBy ?? []).length}>
        {(c.InUseBy ?? []).length ? <ul class="list-disc pl-5">{(c.InUseBy ?? []).map((a) => <li><code class="text-[13px] break-all">{a}</code></li>)}</ul> : <p class="text-muted">This certificate is not associated with any resources.</p>}
      </Card>

      <DataTable title="Tags" rows={(tags.value ?? []).map((t) => ({ id: t.Key, key: t.Key, value: t.Value }))} error={tags.error} select="multi" nameKey="key" id="tags" pageSize={15} filter={false}
        emptyTitle="No tags" emptyText="This certificate has no tags."
        columns={[{ key: 'key', label: 'Key' }, { key: 'value', label: 'Value' }]}>
        <button slot="actions" class="btn btn-normal" name="intent" value="removeTag" data-min="1" data-confirm="The selected tags will be removed." data-confirm-title="Remove tags?" data-confirm-ok="Remove">Remove</button>
      </DataTable>
      <form method="post" class="card"><div class="card-body">
        <input type="hidden" name="intent" value="addTag" />
        <h3 class="card-title mb-3">Add tag</h3>
        <div class="grid gap-4 md:grid-cols-[1fr_1fr_auto] md:items-end">
          <FormField label="Key" for="tkey" class="!mb-0"><input id="tkey" name="key" class="input" required /></FormField>
          <FormField label="Value" for="tval" optional class="!mb-0"><input id="tval" name="value" class="input" /></FormField>
          <button class="btn btn-normal" type="submit">Add tag</button>
        </div>
      </div></form>

      <Card title="Delete certificate">
        <form method="post"><input type="hidden" name="intent" value="deleteCert" />
          <button class="btn btn-danger" data-confirm="The certificate will be permanently deleted." data-confirm-title="Delete certificate?" data-confirm-name={title} data-confirm-type="delete" data-confirm-ok="Delete certificate"><Icon name="trash-2" size={16} /> Delete certificate</button></form>
      </Card>
    </div>
  )}
</Console>
