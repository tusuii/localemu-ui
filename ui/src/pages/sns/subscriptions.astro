---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import { ListSubscriptionsCommand, UnsubscribeCommand } from '@aws-sdk/client-sns';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { arnName, plural } from '../../lib/format';
import { badge } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const sns = aws.sns(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one subscription.');
    for (const s of ids) await sns.send(new UnsubscribeCommand({ SubscriptionArn: s }));
    return `Deleted ${plural(ids.length, 'subscription')}.`;
  },
});
if (post.response) return post.response;
const res = await load(async () => {
  const out: any[] = []; let token: string | undefined;
  do { const r = await sns.send(new ListSubscriptionsCommand({ NextToken: token })); out.push(...(r.Subscriptions ?? [])); token = r.NextToken; } while (token && out.length < 1000);
  return out.map((s) => ({ id: s.SubscriptionArn, topic: arnName(s.TopicArn), protocol: s.Protocol, endpoint: s.Endpoint, arn: s.SubscriptionArn }));
});
---
<Console title="Subscriptions" crumbs={[{ label: 'Subscriptions' }]} error={post.error}>
  <PageHeader title="Subscriptions" />
  <DataTable title="Subscriptions" rows={res.data ?? []} error={res.error} select="multi" nameKey="endpoint" pageSize={25} filter="Search subscriptions"
    emptyTitle="No subscriptions" emptyText="Subscribe an endpoint from a topic's page."
    columns={[
      { key: 'topic', label: 'Topic', href: (r) => `/sns/${encodeURIComponent(r.topic)}` },
      { key: 'protocol', label: 'Protocol', render: (r) => badge(r.protocol) },
      { key: 'endpoint', label: 'Endpoint', mono: true },
      { key: 'arn', label: 'Subscription ARN', mono: true },
    ]}>
    <button slot="actions" class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected subscriptions will be deleted." data-confirm-title="Delete subscriptions?" data-confirm-ok="Delete">Delete</button>
  </DataTable>
</Console>
