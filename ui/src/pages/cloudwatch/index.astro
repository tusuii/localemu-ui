---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Card from '../../components/Card.astro';
import FormField from '../../components/FormField.astro';
import { DescribeAlarmsCommand, PutMetricAlarmCommand, DeleteAlarmsCommand, SetAlarmStateCommand } from '@aws-sdk/client-cloudwatch';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, intOf, required, str, strs } from '../../lib/action';
import { bulk } from '../../lib/bulk';
import { UserError, load } from '../../lib/errors';
import { dateTime, plural } from '../../lib/format';
import { stateStatus } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const cw = aws.cloudwatch(ctx);
const post = await handlePost(Astro, {
  create: async (f) => {
    const thr = Number(required(f, 'threshold', 'Threshold')); if (Number.isNaN(thr)) throw new UserError('Threshold must be a number.');
    await cw.send(new PutMetricAlarmCommand({ AlarmName: required(f, 'name', 'Alarm name'), Namespace: required(f, 'namespace', 'Namespace'), MetricName: required(f, 'metric', 'Metric name'), Statistic: (str(f, 'stat') || 'Average') as never, Period: intOf(f, 'period', 'Period') ?? 60, EvaluationPeriods: intOf(f, 'evals', 'Evaluation periods') ?? 1, Threshold: thr, ComparisonOperator: (str(f, 'op') || 'GreaterThanThreshold') as never, AlarmDescription: str(f, 'description') || undefined }));
    return `Alarm ${str(f, 'name')} created.`;
  },
  delete: async (f) => bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'alarm' }, (a) => cw.send(new DeleteAlarmsCommand({ AlarmNames: [a] }))),
  setOk: async (f) => bulk(strs(f, 'id'), { verb: 'Set to OK:', noun: 'alarm' }, (a) => cw.send(new SetAlarmStateCommand({ AlarmName: a, StateValue: 'OK', StateReason: 'Set from the LocalEmu console' }))),
  setAlarm: async (f) => bulk(strs(f, 'id'), { verb: 'Set to ALARM:', noun: 'alarm' }, (a) => cw.send(new SetAlarmStateCommand({ AlarmName: a, StateValue: 'ALARM', StateReason: 'Set from the LocalEmu console' }))),
});
if (post.response) return post.response;
const res = await load(async () => ((await cw.send(new DescribeAlarmsCommand({ MaxRecords: 100 }))).MetricAlarms ?? []).map((a) => ({ id: a.AlarmName, name: a.AlarmName, state: a.StateValue, metric: `${a.Namespace}/${a.MetricName}`, cond: `${a.MetricName} ${a.ComparisonOperator?.replace('Threshold', '').replace(/([a-z])([A-Z])/g, '$1 $2').toLowerCase()} ${a.Threshold}`, updated: a.StateUpdatedTimestamp })));
const v = post.values;
---
<Console title="Alarms" crumbs={[{ label: 'Alarms' }]} error={post.error}>
  <PageHeader title="Alarms" description="Watch metrics and react when they cross a threshold." />
  <DataTable title="Alarms" rows={res.data ?? []} error={res.error} select="multi" nameKey="name" pageSize={25} filter="Search alarms" emptyTitle="No alarms" emptyText="Create one below."
    columns={[{ key: 'name', label: 'Name' }, { key: 'state', label: 'State', render: (r) => stateStatus(r.state, { ok: 'success', alarm: 'error', insufficient_data: 'stopped' }) }, { key: 'cond', label: 'Conditions' }, { key: 'metric', label: 'Metric' }, { key: 'updated', label: 'State updated', render: (r) => dateTime(r.updated) }]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="setOk" data-min="1">Set state: OK</button>
      <button class="btn btn-normal" name="intent" value="setAlarm" data-min="1">Set state: In alarm</button>
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected alarms will be deleted." data-confirm-title="Delete alarms?" data-confirm-ok="Delete">Delete</button>
    </Fragment>
  </DataTable>
  <Card class="mt-4" title="Create alarm">
    <form method="post" class="space-y-1"><input type="hidden" name="intent" value="create" />
      <div class="grid gap-4 sm:grid-cols-3"><FormField label="Alarm name" for="name"><input id="name" name="name" class="input" required value={v.name ?? ''} /></FormField><FormField label="Namespace" for="ns"><input id="ns" name="namespace" class="input" required placeholder="AWS/Lambda" value={v.namespace ?? ''} /></FormField><FormField label="Metric name" for="metric"><input id="metric" name="metric" class="input" required placeholder="Errors" value={v.metric ?? ''} /></FormField></div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-5"><FormField label="Statistic" for="stat"><select id="stat" name="stat" class="select">{['Average', 'Sum', 'Minimum', 'Maximum', 'SampleCount'].map((s) => <option>{s}</option>)}</select></FormField>
        <FormField label="Period (s)" for="period"><input id="period" name="period" type="number" min="10" class="input" value="60" /></FormField><FormField label="Evaluation periods" for="evals"><input id="evals" name="evals" type="number" min="1" class="input" value="1" /></FormField>
        <FormField label="Condition" for="op"><select id="op" name="op" class="select">{[['GreaterThanThreshold', '>'], ['GreaterThanOrEqualToThreshold', '>='], ['LessThanThreshold', '<'], ['LessThanOrEqualToThreshold', '<=']].map(([k, l]) => <option value={k}>{l}</option>)}</select></FormField>
        <FormField label="Threshold" for="thr"><input id="thr" name="threshold" type="number" step="any" class="input" required /></FormField></div>
      <button class="btn btn-primary" type="submit">Create alarm</button>
    </form>
  </Card>
</Console>
