---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Card from '../../components/Card.astro';
import FormField from '../../components/FormField.astro';
import {
  DescribeDBSnapshotsCommand, DescribeDBInstancesCommand, CreateDBSnapshotCommand, DeleteDBSnapshotCommand, RestoreDBInstanceFromDBSnapshotCommand,
} from '@aws-sdk/client-rds';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, required, strs } from '../../lib/action';
import { bulk } from '../../lib/bulk';
import { UserError, load, soft } from '../../lib/errors';
import { dateTime } from '../../lib/format';
import { badge, stateStatus } from '../../lib/html';
import { engineLabel, validIdentifier } from '../../lib/rds';

const ctx = getCtx(Astro.cookies);
const rds = aws.rds(ctx);

const post = await handlePost(Astro, {
  create: async (f) => {
    const name = required(f, 'snapshotId', 'Snapshot name');
    if (!validIdentifier(name)) throw new UserError('Snapshot names start with a letter and use letters, numbers and single hyphens.');
    await rds.send(new CreateDBSnapshotCommand({ DBInstanceIdentifier: required(f, 'instance', 'DB instance'), DBSnapshotIdentifier: name }));
    return `Snapshot ${name} created.`;
  },
  delete: (f) => bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'snapshot' }, (id) => rds.send(new DeleteDBSnapshotCommand({ DBSnapshotIdentifier: id }))),
  restore: async (f) => {
    const snap = required(f, 'snapshot', 'Snapshot');
    const id = required(f, 'newId', 'New DB identifier').toLowerCase();
    if (!validIdentifier(id)) throw new UserError('Identifiers start with a letter and use only letters, numbers and single hyphens.');
    await rds.send(new RestoreDBInstanceFromDBSnapshotCommand({ DBSnapshotIdentifier: snap, DBInstanceIdentifier: id }));
    return { message: `Restoring ${snap} to new DB instance ${id}.`, redirect: `/rds/${id}` };
  },
});
if (post.response) return post.response;

const snaps = await load(async () => (await rds.send(new DescribeDBSnapshotsCommand({ MaxRecords: 100 }))).DBSnapshots ?? []);
const insts = ((await soft(() => rds.send(new DescribeDBInstancesCommand({})))).value?.DBInstances ?? []).map((d) => d.DBInstanceIdentifier!);
const rows = (snaps.data ?? []).map((s) => ({
  id: s.DBSnapshotIdentifier!, instance: s.DBInstanceIdentifier, type: s.SnapshotType ?? '', engine: engineLabel(s.Engine), status: s.Status,
  size: s.AllocatedStorage, created: s.SnapshotCreateTime,
})).sort((a, b) => (b.created?.getTime() ?? 0) - (a.created?.getTime() ?? 0));
const v = post.values;
---
<Console title="Snapshots" crumbs={[{ label: 'Snapshots' }]} error={post.error}>
  <PageHeader title="Snapshots" description="Point-in-time copies of your DB instances that you can restore into new instances." />
  <div class="space-y-5">
    <DataTable
      title="Snapshots" rows={rows} error={snaps.error} select="multi" nameKey="id" pageSize={20}
      filter="Search snapshots" emptyTitle="No snapshots" emptyText="Take a snapshot of a DB instance to see it here."
      columns={[
        { key: 'id', label: 'Snapshot name', mono: true },
        { key: 'instance', label: 'DB instance', href: (r) => `/rds/${encodeURIComponent(r.instance)}` },
        { key: 'type', label: 'Type', render: (r) => badge(r.type, r.type === 'manual' ? 'blue' : 'soft') },
        { key: 'engine', label: 'Engine' },
        { key: 'size', label: 'Storage', render: (r) => (r.size ? `${r.size} GiB` : '-') },
        { key: 'status', label: 'Status', render: (r) => stateStatus(r.status) },
        { key: 'created', label: 'Created', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => r.created?.getTime() ?? 0 },
      ]}
    >
      <button slot="actions" class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected snapshots will be permanently deleted." data-confirm-title="Delete snapshots?" data-confirm-type="delete" data-confirm-ok="Delete">Delete</button>
    </DataTable>

    <div class="grid gap-5 xl:grid-cols-2">
      <Card title="Take snapshot">
        <form method="post">
          <input type="hidden" name="intent" value="create" />
          <FormField label="DB instance" for="instance"><select id="instance" name="instance" class="select">{insts.map((i) => <option value={i} selected={v.instance === i}>{i}</option>)}</select></FormField>
          <FormField label="Snapshot name" for="snapshotId"><input id="snapshotId" name="snapshotId" class="input" required value={v.snapshotId ?? ''} /></FormField>
          <button class="btn btn-primary" type="submit" disabled={!insts.length}>Take snapshot</button>
        </form>
      </Card>
      <Card title="Restore snapshot" description="Creates a new DB instance from a snapshot.">
        <form method="post">
          <input type="hidden" name="intent" value="restore" />
          <FormField label="Snapshot" for="snapshot"><select id="snapshot" name="snapshot" class="select">{rows.map((s) => <option value={s.id} selected={v.snapshot === s.id}>{s.id}</option>)}</select></FormField>
          <FormField label="New DB identifier" for="newId"><input id="newId" name="newId" class="input" required value={v.newId ?? ''} /></FormField>
          <button class="btn btn-primary" type="submit" disabled={!rows.length}>Restore snapshot</button>
        </form>
      </Card>
    </div>
  </div>
</Console>
