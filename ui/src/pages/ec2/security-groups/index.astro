---
import Console from '../../../layouts/Console.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DataTable from '../../../components/DataTable.astro';
import Icon from '../../../components/Icon.astro';
import { DescribeSecurityGroupsCommand, DeleteSecurityGroupCommand } from '@aws-sdk/client-ec2';
import { aws } from '../../../lib/aws';
import { getCtx } from '../../../lib/context';
import { handlePost, strs } from '../../../lib/action';
import { bulk } from '../../../lib/bulk';
import { UserError, load } from '../../../lib/errors';
import { plural } from '../../../lib/format';

const ctx = getCtx(Astro.cookies);
const ec2 = aws.ec2(ctx);
const post = await handlePost(Astro, {
  delete: async (f) => bulk(strs(f, 'id'), { verb: 'Deleted', noun: 'security group' }, (g) => ec2.send(new DeleteSecurityGroupCommand({ GroupId: g }))),
});
if (post.response) return post.response;
const res = await load(async () => ((await ec2.send(new DescribeSecurityGroupsCommand({}))).SecurityGroups ?? []).map((g) => ({ id: g.GroupId, name: g.GroupName, vpc: g.VpcId, description: g.Description, inbound: g.IpPermissions?.length ?? 0, outbound: g.IpPermissionsEgress?.length ?? 0 })));
---
<Console title="Security groups" crumbs={[{ label: 'Security groups' }]} error={post.error}>
  <PageHeader title="Security groups" />
  <DataTable title="Security groups" rows={res.data ?? []} error={res.error} select="multi" idKey="id" nameKey="name" pageSize={25} filter="Find security groups" emptyTitle="No security groups" emptyText="Create one to control traffic to your instances."
    columns={[
      { key: 'name', label: 'Security group name', href: (r) => `/ec2/security-groups/${r.id}` }, { key: 'id', label: 'Security group ID', mono: true }, { key: 'vpc', label: 'VPC ID', mono: true },
      { key: 'description', label: 'Description' }, { key: 'inbound', label: 'Inbound rules' }, { key: 'outbound', label: 'Outbound rules' },
    ]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected security groups will be deleted. Groups in use can't be deleted." data-confirm-title="Delete security groups?" data-confirm-ok="Delete">Delete</button>
      <a class="btn btn-primary" href="/ec2/security-groups/create"><Icon name="plus" size={16} /> Create security group</a>
    </Fragment>
  </DataTable>
</Console>
