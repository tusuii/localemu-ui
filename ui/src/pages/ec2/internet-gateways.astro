---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Card from '../../components/Card.astro';
import { DescribeInternetGatewaysCommand, DescribeVpcsCommand, CreateInternetGatewayCommand, DeleteInternetGatewayCommand, AttachInternetGatewayCommand, DetachInternetGatewayCommand } from '@aws-sdk/client-ec2';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, required, str, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { plural } from '../../lib/format';
import { nameOf } from '../../lib/ec2';
import { stateStatus } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const ec2 = aws.ec2(ctx);
const one = (f: FormData) => { const ids = strs(f, 'id'); if (ids.length !== 1) throw new UserError('Select exactly one internet gateway.'); return ids[0]; };
const post = await handlePost(Astro, {
  create: async (f) => { const r = await ec2.send(new CreateInternetGatewayCommand({ TagSpecifications: str(f, 'name') ? [{ ResourceType: 'internet-gateway', Tags: [{ Key: 'Name', Value: str(f, 'name') }] }] : undefined })); return `Created internet gateway ${r.InternetGateway?.InternetGatewayId}.`; },
  attach: async (f) => { await ec2.send(new AttachInternetGatewayCommand({ InternetGatewayId: one(f), VpcId: required(f, 'vpc', 'VPC') })); return 'Internet gateway attached.'; },
  detach: async (f) => { const id = one(f); const d = (await ec2.send(new DescribeInternetGatewaysCommand({ InternetGatewayIds: [id] }))).InternetGateways?.[0]; const vpc = d?.Attachments?.[0]?.VpcId; if (!vpc) throw new UserError('That gateway is not attached.'); await ec2.send(new DetachInternetGatewayCommand({ InternetGatewayId: id, VpcId: vpc })); return 'Internet gateway detached.'; },
  delete: async (f) => { const ids = strs(f, 'id'); if (!ids.length) throw new UserError('Select at least one internet gateway.'); for (const g of ids) await ec2.send(new DeleteInternetGatewayCommand({ InternetGatewayId: g })); return `Deleted ${plural(ids.length, 'internet gateway')}.`; },
});
if (post.response) return post.response;
const [res, vpcs] = await Promise.all([
  load(async () => ((await ec2.send(new DescribeInternetGatewaysCommand({}))).InternetGateways ?? []).map((g) => ({ id: g.InternetGatewayId, name: nameOf(g.Tags) || '-', state: g.Attachments?.[0]?.State ?? 'detached', vpc: g.Attachments?.[0]?.VpcId ?? '-' }))),
  load(async () => (await ec2.send(new DescribeVpcsCommand({}))).Vpcs ?? []),
]);
---
<Console title="Internet gateways" crumbs={[{ label: 'Internet gateways' }]} error={post.error}>
  <PageHeader title="Internet gateways" />
  <DataTable title="Internet gateways" rows={res.data ?? []} error={res.error} select="single" idKey="id" nameKey="id" pageSize={25} emptyTitle="No internet gateways" emptyText="Create one to give a VPC internet access."
    columns={[{ key: 'name', label: 'Name' }, { key: 'id', label: 'Internet gateway ID', mono: true }, { key: 'state', label: 'State', render: (r) => stateStatus(r.state, { detached: 'stopped', available: 'success', attached: 'success' }) }, { key: 'vpc', label: 'Attached VPC', mono: true }]}>
    <Fragment slot="actions">
      <button class="btn btn-normal" name="intent" value="detach" data-min="1" data-max="1">Detach</button>
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="The selected internet gateways will be deleted." data-confirm-title="Delete internet gateways?" data-confirm-ok="Delete">Delete</button>
    </Fragment>
  </DataTable>
  <div class="mt-4 grid gap-4 lg:grid-cols-2">
    <Card title="Create internet gateway"><form method="post" class="flex items-end gap-2"><input type="hidden" name="intent" value="create" /><div class="flex-1"><label class="field-label" for="gname">Name <span class="opt font-normal text-muted">- optional</span></label><input id="gname" name="name" class="input" /></div><button class="btn btn-primary" type="submit">Create</button></form></Card>
    <Card title="Attach to VPC" description="Select a gateway in the table above, then choose a VPC.">
      <form method="post" class="flex items-end gap-2" id="attach-form"><input type="hidden" name="intent" value="attach" />
        <div class="flex-1"><label class="field-label" for="avpc">VPC</label><select id="avpc" name="vpc" class="select" required>{(vpcs.data ?? []).map((x) => <option value={x.VpcId}>{x.VpcId} · {x.CidrBlock}</option>)}</select></div>
        <input type="hidden" name="id" id="attach-id" /><button class="btn btn-normal" type="submit">Attach</button></form>
    </Card>
  </div>
  <script>
    // Copy the table's selected gateway into the attach form.
    const form = document.querySelector<HTMLFormElement>('#attach-form');
    document.addEventListener('change', (e) => {
      const t = e.target as HTMLInputElement;
      if (t.matches('[data-row-select]') && form) (form.querySelector('#attach-id') as HTMLInputElement).value = t.value;
    });
  </script>
</Console>
