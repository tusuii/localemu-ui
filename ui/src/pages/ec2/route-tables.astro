---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import { DescribeRouteTablesCommand } from '@aws-sdk/client-ec2';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { load } from '../../lib/errors';
import { nameOf } from '../../lib/ec2';
import { badge, esc, raw } from '../../lib/html';

const ctx = getCtx(Astro.cookies);
const res = await load(async () => ((await aws.ec2(ctx).send(new DescribeRouteTablesCommand({}))).RouteTables ?? []).map((t) => ({
  id: t.RouteTableId, name: nameOf(t.Tags) || '-', vpc: t.VpcId, main: t.Associations?.some((a) => a.Main), subnets: t.Associations?.filter((a) => a.SubnetId).length ?? 0,
  routes: (t.Routes ?? []).map((r) => `${r.DestinationCidrBlock ?? r.DestinationIpv6CidrBlock ?? r.DestinationPrefixListId} → ${r.GatewayId ?? r.NatGatewayId ?? r.InstanceId ?? r.TransitGatewayId ?? r.VpcPeeringConnectionId ?? r.NetworkInterfaceId ?? '?'}`),
})));
---
<Console title="Route tables" crumbs={[{ label: 'Route tables' }]}>
  <PageHeader title="Route tables" description="Read-only view. Manage routes with the AWS CLI, Terraform or CloudFormation." />
  <DataTable title="Route tables" rows={res.data ?? []} error={res.error} idKey="id" pageSize={25} filter="Filter route tables" emptyTitle="No route tables" emptyText="None found."
    columns={[
      { key: 'name', label: 'Name' }, { key: 'id', label: 'Route table ID', mono: true }, { key: 'vpc', label: 'VPC', mono: true }, { key: 'main', label: 'Main', render: (r) => (r.main ? badge('Yes', 'blue') : 'No') },
      { key: 'subnets', label: 'Explicit subnet associations' },
      { key: 'routes', label: 'Routes', render: (r) => raw(r.routes.map((x: string) => `<div class="font-mono text-[12.5px]">${esc(x)}</div>`).join('')), sort: (r) => r.routes.length },
    ]} />
</Console>
