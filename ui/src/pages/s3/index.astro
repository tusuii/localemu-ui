---
import Console from '../../layouts/Console.astro';
import PageHeader from '../../components/PageHeader.astro';
import DataTable from '../../components/DataTable.astro';
import Icon from '../../components/Icon.astro';
import { ListBucketsCommand, DeleteBucketCommand } from '@aws-sdk/client-s3';
import { aws } from '../../lib/aws';
import { getCtx } from '../../lib/context';
import { handlePost, strs } from '../../lib/action';
import { UserError, load } from '../../lib/errors';
import { dateTime } from '../../lib/format';
import { deletePrefix } from '../../lib/s3';
import { plural } from '../../lib/format';

const ctx = getCtx(Astro.cookies);
const s3 = aws.s3(ctx);

const post = await handlePost(Astro, {
  delete: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one bucket.');
    for (const b of ids) await s3.send(new DeleteBucketCommand({ Bucket: b }));
    return `Deleted ${plural(ids.length, 'bucket')}.`;
  },
  empty: async (f) => {
    const ids = strs(f, 'id');
    if (!ids.length) throw new UserError('Select at least one bucket.');
    let n = 0;
    for (const b of ids) n += await deletePrefix(s3, b);
    return `Emptied ${plural(ids.length, 'bucket')} (${plural(n, 'object')} removed).`;
  },
  forceDelete: async (f) => {
    const ids = strs(f, 'id');
    for (const b of ids) { await deletePrefix(s3, b); await s3.send(new DeleteBucketCommand({ Bucket: b })); }
    return `Emptied and deleted ${plural(ids.length, 'bucket')}.`;
  },
});
if (post.response) return post.response;

const res = await load(async () => (await s3.send(new ListBucketsCommand({}))).Buckets ?? []);
const rows = (res.data ?? []).map((b) => ({ id: b.Name!, name: b.Name!, created: b.CreationDate, region: (b as { BucketRegion?: string }).BucketRegion ?? ctx.region }));
rows.sort((a, b) => a.name.localeCompare(b.name));
---
<Console title="Buckets" crumbs={[{ label: 'Buckets' }]} error={post.error}>
  <PageHeader title="Buckets" description="Buckets are containers for data stored in S3." />
  <DataTable
    title="General purpose buckets" rows={rows} error={res.error} select="multi" nameKey="name" pageSize={25}
    filter="Find buckets by name"
    emptyTitle="No buckets" emptyText="You don't have any buckets in this account yet."
    columns={[
      { key: 'name', label: 'Name', href: (r) => `/s3/${encodeURIComponent(r.name)}` },
      { key: 'region', label: 'AWS Region' },
      { key: 'created', label: 'Creation date', nowrap: true, render: (r) => dateTime(r.created), sort: (r) => new Date(r.created ?? 0).getTime() },
    ]}
  >
    <Fragment slot="actions">
      <a class="btn btn-normal" data-href-template="/s3/{id}" data-min="1" data-max="1">View details</a>
      <button class="btn btn-normal" name="intent" value="empty" data-min="1" data-confirm="Permanently deletes every object (and version) in the selected buckets. This can't be undone." data-confirm-title="Empty bucket?" data-confirm-type="permanently delete" data-confirm-ok="Empty">Empty</button>
      <button class="btn btn-normal" name="intent" value="delete" data-min="1" data-confirm="Buckets must be empty before they can be deleted. This can't be undone." data-confirm-title="Delete bucket?" data-confirm-ok="Delete bucket">Delete</button>
      <a class="btn btn-primary" href="/s3/create"><Icon name="plus" size={16} /> Create bucket</a>
    </Fragment>
    <a slot="empty" class="btn btn-primary" href="/s3/create">Create bucket</a>
  </DataTable>
</Console>
