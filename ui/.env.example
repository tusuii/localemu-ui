# Copy to .env (or export in your shell) before `npm run dev` / `npm start`.

# Where LocalEmu's gateway listens, as seen by the console *server*.
LOCALEMU_ENDPOINT=http://localhost:4566

# The same gateway as seen by your *browser* (pre-signed URLs). Defaults to LOCALEMU_ENDPOINT.
# LOCALEMU_PUBLIC_ENDPOINT=http://localhost:4566

# Initial region / account until the user picks one in the top bar.
# LOCALEMU_DEFAULT_REGION=us-east-1
# LOCALEMU_DEFAULT_ACCOUNT=000000000000

# Production server bind address (npm start).
# HOST=127.0.0.1
# PORT=4321
